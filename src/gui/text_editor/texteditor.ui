<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <class>TextEditor</class>

    <widget class="QWidget" name="TextEditor">
        <property name="geometry">
            <rect>
                <x>0</x>
                <y>0</y>
                <width>600</width>
                <height>400</height>
            </rect>
        </property>

        <property name="windowTitle">
            <string>Text Editor</string>
        </property>

        <layout class="QVBoxLayout" name="mainLayout">

            <property name="spacing">
                <number>4</number>
            </property>

            <property name="leftMargin">
                <number>0</number>
            </property>
            <property name="topMargin">
                <number>0</number>
            </property>
            <property name="rightMargin">
                <number>0</number>
            </property>
            <property name="bottomMargin">
                <number>0</number>
            </property>

            <!-- ====================================================== -->
            <!-- Formatting Toolbar                                     -->
            <!-- ====================================================== -->

            <item>
                <widget class="QFrame" name="toolbarFrame">

                    <property name="frameShape">
                        <enum>QFrame::Shape::StyledPanel</enum>
                    </property>

                    <property name="frameShadow">
                        <enum>QFrame::Shadow::Plain</enum>
                    </property>

                    <layout class="QHBoxLayout" name="toolbarLayout">

                        <property name="spacing">
                            <number>4</number>
                        </property>

                        <property name="leftMargin">
                            <number>4</number>
                        </property>
                        <property name="topMargin">
                            <number>4</number>
                        </property>
                        <property name="rightMargin">
                            <number>4</number>
                        </property>
                        <property name="bottomMargin">
                            <number>4</number>
                        </property>

                        <!-- Heading selector -->
                        <item>
                            <widget class="QComboBox" name="headingComboBox">

                                <property name="minimumSize">
                                    <size>
                                        <width>120</width>
                                        <height>0</height>
                                    </size>
                                </property>

                                <item>
                                    <property name="text">
                                        <string>Normal</string>
                                    </property>
                                </item>

                                <item>
                                    <property name="text">
                                        <string># Heading 1</string>
                                    </property>
                                </item>

                                <item>
                                    <property name="text">
                                        <string>## Heading 2</string>
                                    </property>
                                </item>

                                <item>
                                    <property name="text">
                                        <string>### Heading 3</string>
                                    </property>
                                </item>

                            </widget>
                        </item>

                        <!-- Separator -->
                        <item>
                            <widget class="QFrame" name="separator1">
                                <property name="frameShape">
                                    <enum>QFrame::Shape::VLine</enum>
                                </property>
                                <property name="frameShadow">
                                    <enum>QFrame::Shadow::Sunken</enum>
                                </property>
                            </widget>
                        </item>

                        <!-- Bold -->
                        <item>
                            <widget class="QToolButton" name="boldButton">
                                <property name="toolTip">
                                    <string>Bold</string>
                                </property>
                                <property name="text">
                                    <string>B</string>
                                </property>
                                <property name="checkable">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>

                        <!-- Italic -->
                        <item>
                            <widget class="QToolButton" name="italicButton">
                                <property name="toolTip">
                                    <string>Italic</string>
                                </property>
                                <property name="text">
                                    <string>I</string>
                                </property>
                                <property name="checkable">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>

                        <!-- Strikethrough -->
                        <item>
                            <widget class="QToolButton" name="strikethroughButton">
                                <property name="toolTip">
                                    <string>Strikethrough</string>
                                </property>
                                <property name="text">
                                    <string>S</string>
                                </property>
                                <property name="checkable">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>

                        <!-- Separator -->
                        <item>
                            <widget class="QFrame" name="separator2">
                                <property name="frameShape">
                                    <enum>QFrame::Shape::VLine</enum>
                                </property>
                                <property name="frameShadow">
                                    <enum>QFrame::Shadow::Sunken</enum>
                                </property>
                            </widget>
                        </item>

                        <!-- Link -->
                        <item>
                            <widget class="QToolButton" name="linkButton">
                                <property name="toolTip">
                                    <string>Add Link</string>
                                </property>
                                <property name="text">
                                    <string>Link</string>
                                </property>
                            </widget>
                        </item>

                        <!-- Bulleted list -->
                        <item>
                            <widget class="QToolButton" name="bulletListButton">
                                <property name="toolTip">
                                    <string>Bulleted List</string>
                                </property>
                                <property name="text">
                                    <string>• List</string>
                                </property>
                                <property name="checkable">
                                    <bool>true</bool>
                                </property>
                            </widget>
                        </item>

                        <!-- Separator -->
                        <item>
                            <widget class="QFrame" name="separator3">
                                <property name="frameShape">
                                    <enum>QFrame::Shape::VLine</enum>
                                </property>
                                <property name="frameShadow">
                                    <enum>QFrame::Shadow::Sunken</enum>
                                </property>
                            </widget>
                        </item>

                        <!-- Zoom out -->
                        <item>
                            <widget class="QToolButton" name="zoomOutButton">
                                <property name="toolTip">
                                    <string>Zoom Out</string>
                                </property>
                                <property name="text">
                                    <string>−</string>
                                </property>
                            </widget>
                        </item>

                        <!-- Zoom in -->
                        <item>
                            <widget class="QToolButton" name="zoomInButton">
                                <property name="toolTip">
                                    <string>Zoom In</string>
                                </property>
                                <property name="text">
                                    <string>+</string>
                                </property>
                            </widget>
                        </item>

                        <!-- Push everything to the left -->
                        <item>
                            <spacer name="toolbarSpacer">
                                <property name="orientation">
                                    <enum>Qt::Orientation::Horizontal</enum>
                                </property>
                                <property name="sizeHint" stdset="0">
                                    <size>
                                        <width>40</width>
                                        <height>20</height>
                                    </size>
                                </property>
                            </spacer>
                        </item>

                    </layout>
                </widget>
            </item>

            <!-- ====================================================== -->
            <!-- Text Editor                                            -->
            <!-- ====================================================== -->

            <item>
                <widget class="QTextEdit" name="textEdit">

                    <property name="acceptRichText">
                        <bool>true</bool>
                    </property>

                    <property name="placeholderText">
                        <string>Write something...</string>
                    </property>

                </widget>
            </item>

        </layout>
    </widget>

    <resources/>
    <connections/>

</ui>